{
 "multipart": [
  {
   "when": {
    "facing": "north"
   },
   "apply": {
    "model": "irextras:ohle_mast_body"
   }
  },
  {
   "when": {
    "facing": "east"
   },
   "apply": {
    "model": "irextras:ohle_mast_body",
    "y": 90
   }
  },
  {
   "when": {
    "facing": "south"
   },
   "apply": {
    "model": "irextras:ohle_mast_body",
    "y": 180
   }
  },
  {
   "when": {
    "facing": "west"
   },
   "apply": {
    "model": "irextras:ohle_mast_body",
    "y": 270
   }
  },
  {
   "when": {
    "down": "false"
   },
   "apply": {
    "model": "irextras:ohle_mast_base"
   }
  },
  {
   "when": {
    "up": "false"
   },
   "apply": {
    "model": "irextras:ohle_mast_cap"
   }
  }
 ]
}