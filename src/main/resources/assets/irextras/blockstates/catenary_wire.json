{
 "multipart": [
  {
   "apply": {
    "model": "irextras:ohle_wire_core"
   }
  },
  {
   "when": {
    "north": "true"
   },
   "apply": {
    "model": "irextras:ohle_wire_side"
   }
  },
  {
   "when": {
    "east": "true"
   },
   "apply": {
    "model": "irextras:ohle_wire_side",
    "y": 90
   }
  },
  {
   "when": {
    "south": "true"
   },
   "apply": {
    "model": "irextras:ohle_wire_side",
    "y": 180
   }
  },
  {
   "when": {
    "west": "true"
   },
   "apply": {
    "model": "irextras:ohle_wire_side",
    "y": 270
   }
  },
  {
   "when": {
    "north": "false",
    "south": "false",
    "east": "false",
    "west": "false"
   },
   "apply": {
    "model": "irextras:ohle_wire_side"
   }
  },
  {
   "when": {
    "north": "false",
    "south": "false",
    "east": "false",
    "west": "false"
   },
   "apply": {
    "model": "irextras:ohle_wire_side",
    "y": 180
   }
  },
  {
   "when": {
    "arm_n": "true"
   },
   "apply": {
    "model": "irextras:ohle_wire_arm"
   }
  },
  {
   "when": {
    "arm_e": "true"
   },
   "apply": {
    "model": "irextras:ohle_wire_arm",
    "y": 90
   }
  },
  {
   "when": {
    "arm_s": "true"
   },
   "apply": {
    "model": "irextras:ohle_wire_arm",
    "y": 180
   }
  },
  {
   "when": {
    "arm_w": "true"
   },
   "apply": {
    "model": "irextras:ohle_wire_arm",
    "y": 270
   }
  },
  {
   "when": {
    "hung": "true"
   },
   "apply": {
    "model": "irextras:ohle_wire_hanger"
   }
  }
 ]
}